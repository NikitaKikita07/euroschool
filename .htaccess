DirectoryIndex index.html

# Keep decorative homepage hero media out of search indexes.
<IfModule mod_headers.c>
  <FilesMatch "^(schoolHero\.png|school-life\.(webm|mp4))$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Ukrainian pages are canonical at the root. Preserve query strings.
RewriteRule ^uk(?:/|/index\.html)?$ https://euroschool.dp.ua/ [R=301,L]
RewriteRule ^uk/(teachers|creativity|evrika)\.html$ https://euroschool.dp.ua/$1.html [R=301,L]

# Do not redirect Apache's internal DirectoryIndex lookup.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s])
RewriteRule ^index\.html$ https://euroschool.dp.ua/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+ru/index\.html(?:[?\s])
RewriteRule ^ru/index\.html$ https://euroschool.dp.ua/ru/ [R=301,L]

# Legacy aliases go directly to canonical pages.
RewriteRule ^contacts(?:/?|/index\.html)$ https://euroschool.dp.ua/ [R=301,L]
RewriteRule ^teachers(?:/?|/index\.html)$ https://euroschool.dp.ua/teachers.html [R=301,L]
RewriteRule ^creativ(?:/?|/index\.html)$ https://euroschool.dp.ua/creativity.html [R=301,L]
RewriteRule ^eureka(?:/?|/index\.html)$ https://euroschool.dp.ua/evrika.html [R=301,L]
RewriteRule ^(?:gallery|galery)(?:/?|/index\.html)$ https://euroschool.dp.ua/#children-gallery [R=301,L,NE]
